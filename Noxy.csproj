<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Noxy</AssemblyName>
    <RootNamespace>Noxy</RootNamespace>
    <ApplicationIcon>noxy.ico</ApplicationIcon>
    <Version>0.3.9</Version>
    <AssemblyVersion>0.3.9.0</AssemblyVersion>
    <FileVersion>0.3.9.0</FileVersion>
    <InformationalVersion>0.3.9</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Noxy.Tests/**/*.cs" />
  </ItemGroup>
</Project>

